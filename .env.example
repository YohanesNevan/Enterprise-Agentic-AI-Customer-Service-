# TRD §5.7 — jangan commit .env asli. Copy dari file ini.
ENVIRONMENT=development

# ── Dev Customer Auth ──────────────────────────────────────────────
# Fixed-account local customer login (matches the UI autofill button).
DEV_CUSTOMER_AUTH_ENABLED=true
DEV_CUSTOMER_USERNAME=customer_dev
DEV_CUSTOMER_PASSWORD=M8GvyVkrEF5wJZUCg47ylIJHeulmVA6sK0sc
DEV_CUSTOMER_ID=CUST-DEV-001
DEV_TENANT_ID=TNT-TEST
# Optional additional local customer accounts: {"username":{"actor_id":"...","tenant_id":"...","password":"..."}}
DEV_CUSTOMER_ACCOUNTS={}

# Exact local proxy IPs only (for Docker Desktop host-gateway forwarding); leave empty otherwise.
DEV_AUTH_TRUSTED_CLIENTS=

# ── Dev Staff Auth ─────────────────────────────────────────────────
# Staff allowlist (matches the UI autofill button).
DEV_STAFF_AUTH_ENABLED=true
DEV_STAFF_ACCOUNTS={"kb.staff":{"actor_id":"STAFF-KB-001","tenant_id":"TNT-TEST","role":"cs_agent","password":"L5Tz88EhNmxZsRshdqsI0DrMKipGf9dw"},"supervisor_dev":{"actor_id":"STAFF-SUPERVISOR-001","tenant_id":"TNT-TEST","role":"supervisor","password":"SupervisorPassword1234567890"},"officer_dev":{"actor_id":"STAFF-OFFICER-001","tenant_id":"TNT-TEST","role":"complaint_officer","password":"OfficerPassword1234567890"}}

# ── Infrastructure ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://eaics:eaics@localhost:5432/eaics
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_KEY=eaics
S3_SECRET=eaics-secret-ganti-di-lokal

# ── JWT / Service Tokens ───────────────────────────────────────────
JWT_SIGNING_KEY=eaics-dev-jwt-secret-key-min-32-chars-long-ok
JWT_ISSUER=eaics-trusted-issuer
JWT_AUDIENCE=eaics-api
# JSON map of service ID to independent random key (minimum 32 characters); never reuse JWT_SIGNING_KEY.
SERVICE_TOKEN_KEYS={"sla-beat":"eaics-sla-beat-service-key-32chars-ok","outbox-worker":"eaics-outbox-worker-svc-key-32chars-ok","orchestrator":"eaics-orchestrator-svc-key-32chars-ok"}
SERVICE_TOKEN_SCOPES={"sla-beat":["sla.read"],"outbox-worker":["sla.read"],"orchestrator":["ticket.create","ticket.read","case.create","case.read","evidence.request","sla.read","handoff.initiate","conversation.read","conversation.write","knowledge.read","tool.invoke"]}
SERVICE_TOKEN_ROLES={"sla-beat":["supervisor"],"outbox-worker":["supervisor"],"orchestrator":["ai_agent"]}
SERVICE_TENANT_ID=TNT-TEST

# ── LLM ────────────────────────────────────────────────────────────
LLM_PROVIDER=stub
LLM_MODEL=stub-1.0
LLM_API_KEY=
# To opt in to Gemini, explicitly set LLM_PROVIDER=gemini, set LLM_MODEL to an approved model, and supply LLM_API_KEY server-side.
LLM_TIMEOUT_MS=10000

# ── Synthetic data / test ──────────────────────────────────────────
SYNTHETIC_SEED=42
T0_ANCHOR=2026-03-01T00:00:00Z
TEST_MODE=false
